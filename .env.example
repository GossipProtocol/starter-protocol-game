# ── Mode ─────────────────────────────────────────────────────────────────
# With nothing set, `forge test` runs the whole system against an in-memory
# Doppler deployment with mock feeds, and the SDK tests run against the
# vectors the contracts wrote. Set the groups below one at a time to go live.
# Copy this file to `.env` at the repo root and to `packages/contracts/.env`.

# ── Robinhood Chain (contracts, fork tests, local stack) ──────────────────
# Public endpoint for chain 4663. Swap for a private one if rate limited.
# Switches on `BeeefRoundFork.t.sol` and is required by `pnpm fork`.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Pin the fork block for reproducible fork tests (0 = latest).
FORK_BLOCK=0
# `DeployLocal.s.sol`: replace each stock's real Chainlink feed with a mock
# seeded at the live price so rounds can resolve on a fork (default true).
DEV_FEEDS=true
# `pnpm fork`: anvil port (default 8545).
PORT=8545

# ── Indexer (apps/indexer) ───────────────────────────────────────────────
# Node the indexer reads from. Defaults to the local anvil fork.
PONDER_RPC_URL=http://127.0.0.1:8545
# Postgres for `pnpm start`. Leave unset for `pnpm dev` on PGlite.
DATABASE_URL=
# Deployment file written by the deploy scripts (default deployments/local.json).
BEEEF_DEPLOYMENT=

# ── App tables (packages/db) ─────────────────────────────────────────────
# Postgres the migration test applies against, on top of the indexer's views.
# Leave unset to skip that test.
BEEEF_PG_URL=

# ── Server env schema (packages/config/src/env.ts) ───────────────────────
# Read by the keeper and web app you build in the module. Nothing in this
# repo reads them yet.
CHAIN_ID=4663
RPC_URL=
FACTORY_ADDRESS=
START_BLOCK=0
KEEPER_PRIVATE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# The course fee recipient is not an env var on purpose. It lives in
# packages/contracts/src/CourseFee.sol and is a default.
