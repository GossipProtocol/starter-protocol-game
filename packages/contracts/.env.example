# Robinhood Chain mainnet (chain id 4663). Public endpoint, swap for a private one if rate limited.
# Switches on the fork test suite (BeeefRoundFork.t.sol) and is required by `pnpm fork`.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional: pin the fork block for reproducible fork tests (0 = latest).
FORK_BLOCK=0
# Optional: DeployLocal.s.sol swaps real feeds for mocks seeded at the live price (default true).
DEV_FEEDS=true
